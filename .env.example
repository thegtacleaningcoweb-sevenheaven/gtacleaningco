# Copy to .env for local sending, and add the same keys in the Vercel project.
# Free tiers are enough: Resend (resend.com) and Upstash Redis (upstash.com).

# Resend API key. Verify thecleaningco.ca so mail can reach any customer.
RESEND_API_KEY=

# Sender on a domain verified in Resend. Do NOT use Gmail here — Resend will 403 and the form returns 500.
# Until the domain is verified, use: The GTA Cleaning Co. <onboarding@resend.dev>
EMAIL_FROM=The GTA Cleaning Co. <contact@thegtacleaningco.ca>

# Business owner. New signups and quote requests are sent here.
OWNER_EMAIL=thegtacleaningco@gmail.com

# Upstash Redis, or the Vercel KV pair (KV_REST_API_URL / KV_REST_API_TOKEN).
# Used to remember who already claimed WELCOME25.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
