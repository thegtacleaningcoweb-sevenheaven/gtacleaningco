---
import Photo from "./Photo.astro";
import { services } from "../data/content";
---

<section id="services">
  <div class="w">
    <p class="eb">Our services</p>
    <h2>Cleaning solutions for every space</h2>
    <div class="cards">
      {
        services.map((service) => (
          <article class="card" data-svc={service.id}>
            <Photo src={service.image} alt={service.alt} />
            <div class="t">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <a href={service.href}>{service.link}</a>
            </div>
          </article>
        ))
      }
    </div>
    <div class="banner">
      <div>
        <strong>Get a $25 coupon</strong>
        <p>$25 off your first cleaning.</p>
      </div>
      <a class="btn" href="/#quote">Get a $25 coupon →</a>
    </div>
  </div>
</section>
