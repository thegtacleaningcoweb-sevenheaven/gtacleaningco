---
interface Props {
  src?: string;
  alt: string;
  label?: string;
  badge?: string;
  class?: string;
  eager?: boolean;
}
const { src = "", alt, label = "Add photo", badge, class: className = "", eager = false } = Astro.props;
---

<div class:list={["ph", className, { has: Boolean(src) }]} data-t={badge}>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        width="800"
        height="600"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={eager ? "high" : "auto"}
      />
    ) : (
      <span>{label}</span>
    )
  }
</div>
