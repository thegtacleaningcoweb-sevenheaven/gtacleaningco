---
import { exclusions, policies } from "../data/content";
import { addOnChargeNotice, billingNotice } from "../data/notices";
import { checklists } from "../data/checklists";
---

<dialog id="dlg" aria-labelledby="dt">
  <div class="dh">
    <h2 id="dt"></h2>
    <button class="x" type="button" aria-label="Close">×</button>
  </div>
  <div class="db">
    <div class="pn" data-id="policy" data-title="Our Policies">
      <p class="lead">A few simple policies help us give every client a smooth, safe, and professional experience.</p>
      {
        policies.map((policy, index) => (
          <details class:list={[{ callout: policy.highlight }]} open={index === 0 || policy.highlight}>
            <summary>{policy.title}</summary>
            {policy.paragraphs.map((paragraph) => (
              <p set:html={paragraph} />
            ))}
            {policy.list && (
              <ul class="pl">
                {policy.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </details>
        ))
      }
      <p class="lead"><strong>By booking with The GTA Cleaning Co., you agree to the policies above.</strong></p>
    </div>

    <div class="pn" data-id="excl" data-title="Services we don't provide">
      <p class="lead">So there are no surprises, here is what falls outside our scope. Not sure about something? Ask us in the quote form.</p>
      <ul class="ex">
        {
          exclusions.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <span>{item.text}</span>
            </li>
          ))
        }
      </ul>
    </div>

    {
      checklists.map((checklist) => (
        <div class="pn" data-id={checklist.id} data-title={checklist.title}>
          <p class="lead">{checklist.lead}</p>
          {checklist.sections.map((section) => (
            <div>
              <h3>{section.title}</h3>
              <ul class="ck">
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
          <p class="addon-note"><strong>{addOnChargeNotice}</strong></p>
          <aside class="billing-note">
            <strong>Billing & cancellation</strong>
            <p>{billingNotice}</p>
          </aside>
          <div class="nav" style="justify-content:flex-start">
            <a class="btn" href={checklist.pdf} download={checklist.filename}>
              Download PDF
            </a>
          </div>
        </div>
      ))
    }
  </div>
</dialog>

<script>
  import { initDialog } from "../scripts/dialog";
  initDialog();
</script>
