---
import Photo from "./Photo.astro";
import { about, faqs, reviews } from "../data/content";
---

<section id="about">
  <div class="w tri">
    <div>
      <Photo class="r1" src={about.image} alt={about.alt} label="Add team photo" />
      <p class="eb">About us</p>
      <h2 class="about-title">{about.title}</h2>
      {about.paragraphs.map((paragraph) => <p class="muted">{paragraph}</p>)}
    </div>
    <div class="reviews">
      <p class="eb">What our clients say</p>
      {
        reviews.map((review) => (
          <blockquote>
            <p class="stars" aria-label="5 out of 5 stars">★★★★★</p>
            <p>{review.quote}</p>
            <cite>{review.cite}</cite>
          </blockquote>
        ))
      }
    </div>
    <div id="faq">
      <p class="eb">FAQ</p>
      {
        faqs.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>
              {item.answer}
              {"more" in item && (
                <>
                  {" "}
                  <a href={item.more.href}>{item.more.label}</a>
                </>
              )}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
