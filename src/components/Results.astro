---
import Photo from "./Photo.astro";
import { galleryPairs } from "../data/content";
import { images } from "../data/images";
---

<section id="results">
  <div class="w">
    <p class="eb">Proven results</p>
    <h2>Real transformations</h2>
    <div class="res">
      {
        galleryPairs.map((pair) => (
          <figure>
            <div class="ba">
              <Photo class="bf" src={pair.before} alt={pair.beforeAlt} label="Before photo" />
              <Photo class="af" src={pair.after} alt={pair.afterAlt} label="After photo" />
              <div class="hd"></div>
              <span class="tg l">Before</span>
              <span class="tg r">After</span>
              <input type="range" min="0" max="100" value="50" aria-label={`Compare before and after: ${pair.caption}`} />
            </div>
            <figcaption class="ba-cap">{pair.caption}</figcaption>
          </figure>
        ))
      }
      {
        images.gallery.some(Boolean) && (
          <div class="gal">
            {images.gallery.map(
              (src, index) =>
                src && <Photo class="r3" src={src} alt={`Finished cleaning detail ${index + 1}`} label="Add" />,
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  import { initSlider } from "../scripts/slider";
  initSlider();
</script>
