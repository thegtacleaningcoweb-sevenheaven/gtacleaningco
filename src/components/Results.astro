---
import Photo from "./Photo.astro";
import { galleryPairs } from "../data/content";
import { images } from "../data/images";
---

<section id="results">
  <div class="w">
    <p class="eb">Proven results</p>
    <h2>Real transformations</h2>
    <div class="res">
      {
        galleryPairs.map((pair) => (
          <figure>
            <div class="ba">
              <Photo class="bf" src={pair.before} alt={pair.beforeAlt} label="Before photo" />
              <Photo class="af" src={pair.after} alt={pair.afterAlt} label="After photo" />
              <div class="hd"></div>
              <span class="tg l">Before</span>
              <span class="tg r">After</span>
              <input type="range" min="0" max="100" value="50" aria-label={`Compare before and after: ${pair.caption}`} />
            </div>
            <figcaption class="ba-cap">{pair.caption}</figcaption>
          </figure>
        ))
      }
      <div class="gal-cta">
        <button class="btn" type="button" data-gallery-open>Gallery</button>
      </div>
    </div>
  </div>
  <dialog id="gallery" class="gallery" aria-labelledby="gallery-title">
    <div class="dh">
      <h2 id="gallery-title">Gallery</h2>
      <button class="gallery-x" type="button" data-gallery-close aria-label="Close">×</button>
    </div>
    <div class="gallery-grid" data-gallery-grid>
      {
        images.gallery.map((photo, index) => (
          <button class="gallery-thumb" type="button" data-gallery-index={index} aria-label={photo.alt}>
            <img src={photo.src} alt={photo.alt} width="768" height="1024" loading="lazy" decoding="async" />
          </button>
        ))
      }
    </div>
    <div class="gallery-view" data-gallery-view hidden>
      <button class="gallery-x" type="button" data-gallery-close aria-label="Close">×</button>
      <button class="gallery-nav prev" type="button" data-gallery-prev aria-label="Previous photo">&lt;</button>
      <div class="gallery-stage">
        <img data-gallery-full alt="" tabindex="-1" />
      </div>
      <button class="gallery-nav next" type="button" data-gallery-next aria-label="Next photo">&gt;</button>
      <p class="gallery-count" data-gallery-count aria-live="polite"></p>
    </div>
  </dialog>
</section>

<script>
  import { initSlider } from "../scripts/slider";
  import { initGallery } from "../scripts/gallery";
  initSlider();
  initGallery();
</script>
