---
import { compareColumns, compareTasks, type Coverage } from "../data/compare";

const columnIds = ["svc-regular", "svc-deep", "svc-move"] as const;
---

<section id="compare">
  <div class="w">
    <p class="eb">Compare services</p>
    <h2>What's included in each clean</h2>
    <p class="lead">A check is included. A cross is not. Add-ons are optional extras.</p>
    <div class="cmp">
      <table id="cmp">
        <caption class="sr-only">What's included in Regular, Deep, and Move-In / Move-Out cleaning</caption>
        <thead>
          <tr>
            <th scope="col">Task</th>
            {
              compareColumns.map((column, index) => (
                <th scope="col" id={columnIds[index]}>
                  {column.lines[0]}
                  <br />
                  {column.lines[1]}
                  <button type="button" data-quote={column.id}>
                    Get a quote
                  </button>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            compareTasks.flatMap((task, index) => {
              const showGroup = index === 0 || compareTasks[index - 1].area !== task.area;
              const values: Coverage[] = [task.regular, task.deep, task.move];
              const row = (
                <tr>
                  <th scope="row">{task.name}</th>
                  {values.map((value) => (
                    <td>
                      {value === 1 && (
                        <i class="y" aria-label="Included">
                          ✓
                        </i>
                      )}
                      {value === 0 && (
                        <i class="n" aria-label="Not included">
                          ✕
                        </i>
                      )}
                      {value === 2 && (
                        <i class="a" aria-label="Optional add-on">
                          Add-on
                        </i>
                      )}
                    </td>
                  ))}
                </tr>
              );
              if (!showGroup) return [row];
              return [
                <tr class="gr">
                  <th scope="colgroup" colspan="4">
                    {task.area}
                  </th>
                </tr>,
                row,
              ];
            })
          }
        </tbody>
      </table>
    </div>
    <div class="lg">
      <span><i class="y">✓</i> Included</span>
      <span><i class="n">✕</i> Not included</span>
      <span><i class="a">Add-on</i> Optional extra</span>
    </div>
    <dialog class="regular-note" id="regular-note" aria-labelledby="regular-note-copy">
      <p id="regular-note-copy">
        Please carefully review our <button class="text-btn" type="button" data-open="regular">Regular Cleaning</button> checklist to understand what's included. New customers are advised to start with a <button class="text-btn" id="regular-note-deep" type="button">Deep Cleaning</button> if your home hasn't been professionally cleaned in the last 30 days.
      </p>
      <button class="btn block" id="regular-note-ok" type="button">OK</button>
    </dialog>
    <aside class="important">
      <p>If you're a first-time customer who hasn't had a professional cleaning in the last 30 days, we strongly recommend starting with a <a href="#svc-deep">Deep Cleaning</a>.</p>
      <p>Please know that our 100% Satisfaction Guarantee does not cover our Home Cleaning per Hour service.</p>
      <p>Check out our <a href="/#checklists">Cleaning Checklist</a> to see what's included in each of our various cleaning services.</p>
    </aside>
  </div>
</section>

<script>
  import { initCompare } from "../scripts/compare";
  initCompare();
</script>
