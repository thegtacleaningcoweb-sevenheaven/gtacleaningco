---
import { compareTasks, type CompareTask } from "../data/compare";

const sheets = [
  { id: "svc-regular", field: "regular", title: "Regular Cleaning", quote: 1 },
  { id: "svc-deep", field: "deep", title: "Deep Cleaning", quote: 2 },
  { id: "svc-move", field: "move", title: "Move-In / Move-Out", quote: 3 },
] as const;

function groupsFor(field: "regular" | "deep" | "move") {
  const groups: { area: string; names: string[] }[] = [];
  for (const task of compareTasks) {
    if (task[field] !== 1) continue;
    const area = task.area === "Add-ons" ? "Kitchen" : task.area;
    const group = groups.find((item) => item.area === area);
    if (group) group.names.push(task.name);
    else groups.push({ area, names: [task.name] });
  }
  return groups;
}

function addOnNote(task: CompareTask) {
  const included = [
    task.regular === 1 ? "Regular" : "",
    task.deep === 1 ? "Deep" : "",
    task.move === 1 ? "Move-In / Move-Out" : "",
  ].filter(Boolean);
  return included.length ? `Included with ${included.join(" and ")}` : "";
}

const addOns = compareTasks
  .filter((task) => task.regular === 2 || task.deep === 2 || task.move === 2)
  .map((task) => ({ name: task.name, note: addOnNote(task) }));

---

<section id="compare">
  <div class="w">
    <p class="eb">Compare services</p>
    <h2>What's included in each clean</h2>
    <p class="lead">Each clean is listed on its own. Everything in a list is included. Add-ons are separate.</p>
    {
      sheets.map((sheet) => (
        <article class="sheet" id={sheet.id}>
          <div class="sheet-top">
            <h3>{sheet.title}</h3>
            <button class="sheet-quote" type="button" data-quote={sheet.quote}>
              Get a quote →
            </button>
          </div>
          <div class="sheet-grid">
            {groupsFor(sheet.field).map((group) => (
              <div>
                <h4>{group.area}</h4>
                <ul>
                  {group.names.map((name) => (
                    <li>{name}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </article>
      ))
    }
    <article class="sheet" id="svc-addons">
      <div class="sheet-top">
        <h3>Add-ons</h3>
        <a class="sheet-quote" href="/#quote">Add to my quote →</a>
      </div>
      <ul class="addon-list">
        {
          addOns.map((item) => (
            <li>
              {item.name}
              {item.note && <small>{item.note}</small>}
            </li>
          ))
        }
      </ul>
    </article>
    <dialog class="regular-note" id="regular-note" aria-labelledby="regular-note-copy">
      <p id="regular-note-copy">
        Please carefully review our <button class="text-btn" type="button" data-open="regular">Regular Cleaning</button> checklist to understand what's included. New customers are advised to start with a <button class="text-btn" id="regular-note-deep" type="button">Deep Cleaning</button> if your home hasn't been professionally cleaned in the last 30 days.
      </p>
      <button class="btn block" id="regular-note-ok" type="button">OK</button>
    </dialog>
    <aside class="important">
      <p>If you're a first-time customer who hasn't had a professional cleaning in the last 30 days, we strongly recommend starting with a <a href="#svc-deep">Deep Cleaning</a>.</p>
      <p>Please know that our 100% Satisfaction Guarantee does not cover our Home Cleaning per Hour service.</p>
      <p>Check out our <a href="/#checklists">Cleaning Checklist</a> to see what's included in each of our various cleaning services.</p>
    </aside>
  </div>
</section>

<script>
  import { initCompare } from "../scripts/compare";
  initCompare();
</script>
